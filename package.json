{
  "name": "gba_console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "scripts": {
    "audit:tables": "node scripts/audit-table-patterns.mjs",
    "audit:tables:check": "node scripts/audit-table-patterns.mjs --check",
    "audit:event-permissions": "node scripts/event-permission-candidates.mjs",
    "audit:event-permissions:check": "node scripts/event-permission-candidates.mjs --check",
    "audit:event-permissions:matrix": "node scripts/classify-event-permission-matrix.mjs",
    "audit:event-permissions:matrix:check": "node scripts/classify-event-permission-matrix.mjs --check",
    "audit:event-permissions:matrix:test": "node --test scripts/classify-event-permission-matrix.unit.mjs",
    "audit:event-permissions:matrix:write": "node scripts/classify-event-permission-matrix.mjs --write",
    "audit:event-permissions:parity": "node scripts/check-event-permission-parity.mjs",
    "audit:event-permissions:parity:test": "node --test scripts/check-event-permission-parity.unit.mjs",
    "audit:event-permissions:test": "node --test scripts/event-permission-candidates.unit.mjs",
    "audit:event-permissions:write": "node scripts/event-permission-candidates.mjs --write",
    "verify:event-permissions": "npm run audit:event-permissions:check && npm run audit:event-permissions:matrix:check && npm run audit:event-permissions:test && npm run audit:event-permissions:matrix:test && npm run audit:event-permissions:parity:test && npm run audit:event-permissions:parity",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:action-guard": "node --test scripts/ui-action-guard-plugin.test.mjs && vitest run src/shared/ui/action-guard",
    "preview": "vite preview",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:full": "playwright test --project=full",
    "e2e:live-sync-audit": "playwright test --config=playwright.live-sync.config.ts",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@mantine/charts": "^9.7.3",
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@microsoft/signalr": "^10.0.11",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.61.0",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mssql": "^12.7.11",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/msal-node": "7.1.1"
  }
}
