ю в довіднику вибрану групу потрібно замінити перед формуванням.","Суми продажів розподілено за фактичним списанням; повернення — за власним складом. Невідвантажені рядки не входять у відбір; за неповних складських даних звіт не формується."]},"RowSchema":[{"Position":0,"Identity":"Product","Caption":"Товар","DisplayKind":"Text","KeyKind":"Numeric","Captioned":true,"AgreementRole":"none"}],"ColumnSchema":[{"Position":0,"Identity":"CustomerComparisonSource","Caption":"Джерело даних","DisplayKind":"Text","KeyKind":"Text","Captioned":false,"AgreementRole":"none"},{"Position":1,"Identity":"$measureGroup","Caption":"Група показників","DisplayKind":"Text","KeyKind":"Text","Captioned":false,"AgreementRole":"none"},{"Position":2,"Identity":"$measure","Caption":"Показник","DisplayKind":"Text","KeyKind":"Text","Captioned":false,"AgreementRole":"none"}],"Rows":[{"Ordinal":1,"SourceIndex":1,"Values":[{"Identity":{"Kind":"signedInteger","Value":"2","Provenance":"rowAxisKey"},"Caption":"Product2"}]}],"Columns":[{"Ordinal":0,"SourceIndex":0,"Values":[{"Identity":{"Kind":"text","Value":"Еталон","Provenance":"columnAxisKey"},"Caption":"Еталон"},{"Identity":{"Kind":"text","Value":"Інше","Provenance":"columnAxisKey"},"Caption":"Інше"},{"Identity":{"Kind":"reportField","Value":"CustomerGroupQuantity","Provenance":"columnAxisKey"},"Caption":"Кількість"}]},{"Ordinal":1,"SourceIndex":1,"Values":[{"Identity":{"Kind":"text","Value":"Еталон","Provenance":"columnAxisKey"},"Caption":"Еталон"},{"Identity":{"Kind":"text","Value":"Інше","Provenance":"columnAxisKey"},"Caption":"Інше"},{"Identity":{"Kind":"reportField","Value":"CustomerGroupQuantityDelta","Provenance":"columnAxisKey"},"Caption":"Відхилення кількості, абс."}]},{"Ordinal":2,"SourceIndex":2,"Values":[{"Identity":{"Kind":"text","Value":"Еталон","Provenance":"columnAxisKey"},"Caption":"Еталон"},{"Identity":{"Kind":"text","Value":"Інше","Provenance":"columnAxisKey"},"Caption":"Інше"},{"Identity":{"Kind":"reportField","Value":"CustomerGro